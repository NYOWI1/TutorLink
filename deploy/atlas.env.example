# Local configuration: copy these settings to the ignored .env.local file.
# Replace the placeholder with the URL-encoded database-user password.
MONGODB_URI=mongodb+srv://u6622062_db_user:<db_password>@cluster0.cnyc2gc.mongodb.net/tutorlink?appName=Cluster0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_ORIGIN=http://localhost:3000

# On the VM, preserve its existing JWT_SECRET, APP_ORIGIN, base path, and port.
# Only add MONGODB_URI to its .env, then recreate the app container.
# Atlas is a managed service; using it deviates from instruction.md.
